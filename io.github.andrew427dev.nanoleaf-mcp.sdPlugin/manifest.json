{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Nanoleaf MCP",
  "UUID": "io.github.andrew427dev.nanoleaf-mcp",
  "Version": "0.4.0.2",
  "Author": "andrew427dev",
  "Description": "Control the USB-only PC Screen Mirror Lightstrip (NL82K2) through Nanoleaf Desktop's local MCP server. Power, brightness and saved scenes. Unofficial macOS beta; not for Wi-Fi/LAN Nanoleaf models.",
  "URL": "https://github.com/andrew427dev/streamdeck-nanoleaf-mcp",
  "Category": "Nanoleaf MCP",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "PropertyInspectorPath": "ui/index.html",
  "Actions": [
    {
      "UUID": "io.github.andrew427dev.nanoleaf-mcp.power",
      "Name": "Power",
      "Tooltip": "Turn a selected light on, off, or toggle its power.",
      "Icon": "imgs/power-action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/power-unknown-key",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "io.github.andrew427dev.nanoleaf-mcp.scene",
      "Name": "Scene",
      "Tooltip": "Play an existing Nanoleaf Desktop scene on a selected light.",
      "Icon": "imgs/scene-action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/scene-key",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "io.github.andrew427dev.nanoleaf-mcp.brightness-up",
      "Name": "Brightness Up",
      "Tooltip": "Increase the selected light's brightness by a configurable step.",
      "Icon": "imgs/brightness-up-action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/brightness-up-key",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "io.github.andrew427dev.nanoleaf-mcp.brightness-down",
      "Name": "Brightness Down",
      "Tooltip": "Decrease the selected light's brightness by a configurable step.",
      "Icon": "imgs/brightness-down-action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/brightness-down-key",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "io.github.andrew427dev.nanoleaf-mcp.brightness-dial",
      "Name": "Brightness Dial",
      "Tooltip": "Turn to adjust brightness, press to toggle power, and tap the touch strip to change the display.",
      "Icon": "imgs/brightness-dial-action",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/brightness.json",
        "TriggerDescription": {
          "Rotate": "Adjust brightness",
          "Push": "Toggle power",
          "Touch": "Cycle bar / ring / number display"
        }
      },
      "States": [
        {
          "Image": "imgs/brightness-dial-key",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "io.github.andrew427dev.nanoleaf-mcp.scene-dial",
      "Name": "Scene Browser",
      "Tooltip": "Press or tap to open saved scenes, turn to select, then press or tap to play.",
      "Icon": "imgs/scene-dial-action",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/scenes.json",
        "TriggerDescription": {
          "Rotate": "Select scene",
          "Push": "Open scenes / play selection",
          "Touch": "Open scenes / play selection"
        }
      },
      "States": [
        {
          "Image": "imgs/scene-dial-key",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    }
  ]
}
