{
  "name": "streamdeck-nanoleaf-mcp",
  "version": "0.7.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Unofficial macOS and experimental Windows Stream Deck control for the USB-only Nanoleaf PC Screen Mirror Lightstrip (NL82K2), through Nanoleaf Desktop local MCP",
  "license": "MIT",
  "author": "andrew427dev",
  "repository": "github:andrew427dev/streamdeck-nanoleaf-mcp",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run build && node --test",
    "build": "node scripts/build.mjs",
    "validate": "streamdeck validate io.github.andrew427dev.nanoleaf-mcp.sdPlugin",
    "pack": "node scripts/pack.mjs",
    "audit:security": "npm audit --audit-level=info",
    "version:check": "node scripts/check-version.mjs",
    "version:release": "node scripts/check-version.mjs --git-tags"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.5"
  },
  "overrides": {
    "@elgato/utils": {
      "zod": "4.6.7"
    }
  },
  "devDependencies": {
    "@elgato/cli": "1.10.5",
    "@zip.js/zip.js": "2.25.0",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "ws": "8.23.0"
  }
}
